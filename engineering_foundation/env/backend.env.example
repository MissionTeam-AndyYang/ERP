# Secret-free local backend template.
# Copy to the ignored backend/.env file and replace placeholders only with
# approved, non-production local values.
APP_NAME=ERP 2.0 Backend
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:3306/LOCAL_DATABASE?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
